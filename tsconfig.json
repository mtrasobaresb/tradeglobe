{
  "extends": "gts/tsconfig-google.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],  // Tells TS about console and browser windows.
    "types": ["vite/client"],                  // Tells TS how to process .css and .svg imports.
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "d3-geo": ["./node_modules/@types/d3-geo/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}